function calculate()
{

let num1=20;
let num2=10;

let add=num1+num2;
let sub=num1-num2;
let mul=num1*num2;
let div=num1/num2;

let output="";

output+="Number 1="+num1+"<br>";
output+="Number 2="+num2+"<br><br>";

output+="Addition="+add+"<br>";
output+="substraction="+sub+"<br>';
output+="Multiplication="+mul+"<br>";
output+="division="+div+"<br><br>";

//
===============================
// conditions
//
===============================

if(num1>num2)
{
output+="20 is greater than 10 <br><br>";
}
else
{
output+="Numbers from 1 to 10<br>";

for(let i=1;i<=10;i++)
{
output+=i+" ";
}

document.getElementById("result").innerHTML=output;

}

